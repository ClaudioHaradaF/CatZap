{
  "manifest_version": 3,
  "name": "CatZap",
  "version": "1.1",
  "description": "Transcreve audios do WhatsApp ao clicar no play.",
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ],
  "host_permissions": [
    "http://127.0.0.1:51777/*"
  ],
  "permissions": [
    "storage"
  ]
}
